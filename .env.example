# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Storage Paths
DATABASE_PATH=data/autothreat.db
CHROMA_PATH=chroma_db

# Email / SMTP Alert Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient@company.com
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@company.com

# Webhook Alert Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# API & Dashboard Configuration
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_URL=http://localhost:8501
CORS_ORIGINS=*
AUTOTHREAT_API_KEY=

# Pipeline & Validation Controls
CRAWL_INTERVAL_HOURS=6
MIN_VALIDATION_SCORE=70
MAX_VALIDATION_RETRIES=3
LOG_LEVEL=INFO
LOG_TO_FILE=True
SCHEMA_VERSION=v3
DELAY_BETWEEN_LIGHT_AGENTS=1
DELAY_BETWEEN_HEAVY_AGENTS=5
ARTICLE_DELAY_SECONDS=90
MAX_ARTICLES_PER_CYCLE=3
ENABLE_MULTI_PLATFORM=true
